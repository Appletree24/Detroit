#!/bin/sh
# Prefer the optional project-local Bun installation; otherwise use system Bun.
set -eu
detroit_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
detroit_bun="$detroit_root/.tools/node_modules/.bin/bun"
if [ -x "$detroit_bun" ]; then
  PATH="$detroit_root/.tools/node_modules/.bin:$PATH"
  export PATH
  exec "$detroit_bun" "$@"
fi
exec bun "$@"
